<Window x:Class="TakeBreak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сделай перерыв" Width="650" Height="720" ResizeMode="CanMinimize"
        MinWidth="650" MaxWidth="650" MinHeight="720" MaxHeight="720"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,10">
        <TextBlock Text="Ваш спокойный ритм" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Работайте с фокусом. Отдыхайте вовремя." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,16" />
        <Border CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="StatusLabel" Text="ВАШ СЛЕДУЮЩИЙ ПЕРЕРЫВ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="Перерывы" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ToggleButton x:Name="EnabledSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="Включить перерывы" Checked="SettingsChanged" Unchecked="SettingsChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,5,16,0">
              <TextBlock x:Name="NextBreakText" Text="через 40 минут" FontSize="25" FontWeight="SemiBold" />
              <TextBlock x:Name="NextBreakDetail" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="1" Content="Отдохнуть сейчас  →" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="14,9" Margin="0,8,0,0" Click="BreakNow_Click" />
          </Grid>
        </Border>
        <TextBlock Text="Настройки перерывов" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid Margin="0,0,0,22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12">
            <StackPanel>
              <TextBlock Text="Интервал" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid>
                <TextBox x:Name="IntervalInput" Style="{StaticResource NumericInput}" TextAlignment="Left" Padding="12,0,112,0" MaxLength="3" TextChanged="SettingsChanged" AutomationProperties.Name="Интервал в минутах" />
                <TextBlock x:Name="IntervalUnitText" Text="минут работы" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" />
              </Grid>
              <UniformGrid Rows="1" Columns="3" Margin="0,10,-6,0">
                <Button Content="30 мин" Tag="30" Click="IntervalPreset_Click" Padding="0,6" Margin="0,0,6,0" FontSize="12" />
                <Button Content="40 мин" Tag="40" Click="IntervalPreset_Click" Padding="0,6" Margin="0,0,6,0" FontSize="12" />
                <Button Content="60 мин" Tag="60" Click="IntervalPreset_Click" Padding="0,6" Margin="0,0,6,0" FontSize="12" />
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12">
            <StackPanel>
              <TextBlock Text="Длительность" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid>
                <TextBox x:Name="DurationInput" Style="{StaticResource NumericInput}" TextAlignment="Left" Padding="12,0,112,0" MaxLength="3" TextChanged="SettingsChanged" AutomationProperties.Name="Длительность перерыва в минутах" />
                <TextBlock x:Name="DurationUnitText" Text="минут отдыха" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" />
              </Grid>
              <UniformGrid Rows="1" Columns="3" Margin="0,10,-6,0">
                <Button Content="3 мин" Tag="3" Click="DurationPreset_Click" Padding="0,6" Margin="0,0,6,0" FontSize="12" />
                <Button Content="5 мин" Tag="5" Click="DurationPreset_Click" Padding="0,6" Margin="0,0,6,0" FontSize="12" />
                <Button Content="10 мин" Tag="10" Click="DurationPreset_Click" Padding="0,6" Margin="0,0,6,0" FontSize="12" />
              </UniformGrid>
            </StackPanel>
          </Border>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Расписание" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Только в нужные часы" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="StartInput" Style="{StaticResource NumericInput}" Width="82" MaxLength="5" TextChanged="SettingsChanged" AutomationProperties.Name="Начало рабочего времени" />
            <TextBlock Text="—" Foreground="{StaticResource MutedBrush}" Margin="10,0" VerticalAlignment="Center" />
            <TextBox x:Name="EndInput" Style="{StaticResource NumericInput}" Width="82" MaxLength="5" TextChanged="SettingsChanged" AutomationProperties.Name="Конец рабочего времени" />
          </StackPanel>
        </Grid>
        <UniformGrid x:Name="DaysPanel" Rows="1" Columns="7" Margin="0,12,-8,24">
          <ToggleButton Content="Пн" Tag="Monday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <ToggleButton Content="Вт" Tag="Tuesday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <ToggleButton Content="Ср" Tag="Wednesday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <ToggleButton Content="Чт" Tag="Thursday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <ToggleButton Content="Пт" Tag="Friday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <ToggleButton Content="Сб" Tag="Saturday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
          <ToggleButton Content="Вс" Tag="Sunday" Height="40" Style="{StaticResource DayButton}" Checked="SettingsChanged" Unchecked="SettingsChanged" />
        </UniformGrid>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Акцентный цвет" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="AccentPickerButton" Grid.Column="1" Click="AccentPicker_Click" Padding="12,8" ToolTip="Открыть палитру цветов" AutomationProperties.Name="Выбрать акцентный цвет в палитре">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="AccentSwatch" Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentBrush}" BorderBrush="#60FFFFFF" BorderThickness="1" Margin="0,0,10,0" />
              <TextBlock x:Name="AccentHexText" Text="#B8CDB5" FontSize="12" VerticalAlignment="Center" />
              <Path Data="M 0,0 L 4,4 L 8,0" Width="9" Height="5" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Запускать при включении компьютера" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="В трее, без окна настроек" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <ToggleButton x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="Запускать при включении компьютера" Checked="StartupChanged" Unchecked="StartupChanged" />
        </Grid>
        <TextBlock x:Name="SettingsError" Visibility="Collapsed" Foreground="#FFB1A1" FontSize="12" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" Margin="28,8,28,14">
      <TextBlock Text="TAKE BREAK" Foreground="#777777" FontSize="10" />
      <TextBlock Text="v0.8.0" Foreground="#777777" FontSize="11" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</Window>
