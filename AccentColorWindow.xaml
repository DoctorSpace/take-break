<Window x:Class="TakeBreak.AccentColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Акцентный цвет" Width="360" Height="490" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Выберите оттенок" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
    <Grid x:Name="ColorPlane" Grid.Row="1" MinHeight="140" Background="Red" ClipToBounds="True" Cursor="Cross"
          MouseLeftButtonDown="Plane_MouseDown" MouseMove="Plane_MouseMove" MouseLeftButtonUp="Plane_MouseUp"
          AutomationProperties.Name="Насыщенность и яркость цвета">
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFFFF" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
      </Rectangle>
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" /><GradientStop Color="#FF000000" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
      </Rectangle>
      <Canvas IsHitTestVisible="False">
        <Ellipse x:Name="ColorMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent">
          <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.8" /></Ellipse.Effect>
        </Ellipse>
      </Canvas>
    </Grid>
    <Grid Grid.Row="2" Height="24" Margin="0,16,0,16">
      <Border CornerRadius="6" Margin="0,5">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Red" Offset="0" /><GradientStop Color="Yellow" Offset="0.1667" /><GradientStop Color="Lime" Offset="0.3333" />
            <GradientStop Color="Cyan" Offset="0.5" /><GradientStop Color="Blue" Offset="0.6667" /><GradientStop Color="Magenta" Offset="0.8333" /><GradientStop Color="Red" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Slider x:Name="HueSlider" Minimum="0" Maximum="359.99" ValueChanged="Hue_Changed" SmallChange="1" LargeChange="15" AutomationProperties.Name="Цветовой тон">
        <Slider.Template>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Width="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="5" Background="#333333" BorderBrush="White" BorderThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Slider.Template>
      </Slider>
    </Grid>
    <Grid Grid.Row="3" Height="38">
      <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border x:Name="PreviewSwatch" CornerRadius="9" BorderBrush="#60FFFFFF" BorderThickness="1" />
      <TextBlock Grid.Column="1" Text="HEX" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
      <TextBox x:Name="HexInput" Grid.Column="2" Width="128" MaxLength="7" FontSize="15" TextChanged="Hex_Changed" AutomationProperties.Name="Цвет в формате HEX, например #B8CDB5" />
    </Grid>
    <Grid x:Name="PresetColors" Grid.Row="4" Margin="0,16,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" />
      </Grid.ColumnDefinitions>
      <Grid.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" />
          <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>
      </Grid.Resources>
      <Button Background="#B8CDB5" Tag="#B8CDB5" Click="Preset_Click" ToolTip="Применить: шалфей" AutomationProperties.Name="Применить цвет шалфей" />
      <Button Grid.Column="2" Background="#A5FF6D" Tag="#A5FF6D" Click="Preset_Click" ToolTip="Применить: лайм" AutomationProperties.Name="Применить цвет лайм" />
      <Button Grid.Column="4" Background="#C4B8DB" Tag="#C4B8DB" Click="Preset_Click" ToolTip="Применить: лаванда" AutomationProperties.Name="Применить цвет лаванда" />
      <Button Grid.Column="6" Background="#DCC8A3" Tag="#DCC8A3" Click="Preset_Click" ToolTip="Применить: песок" AutomationProperties.Name="Применить цвет песок" />
      <Button Grid.Column="8" Background="#D9B4B5" Tag="#D9B4B5" Click="Preset_Click" ToolTip="Применить: роза" AutomationProperties.Name="Применить цвет роза" />
      <Button Grid.Column="10" Background="#C8C8C8" Tag="#C8C8C8" Click="Preset_Click" ToolTip="Применить: серебро" AutomationProperties.Name="Применить цвет серебро" />
    </Grid>
    <TextBlock x:Name="ColorError" Grid.Row="5" FontSize="11" Foreground="#FFB1A1" Margin="0,0,0,8" Visibility="Collapsed" />
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button Content="Отмена" IsCancel="True" Padding="12,9" />
      <Button x:Name="ApplyButton" Grid.Column="2" Content="Выбрать" Style="{StaticResource PrimaryButton}" Padding="12,9" Click="Apply_Click" />
    </Grid>
  </Grid>
</Window>
